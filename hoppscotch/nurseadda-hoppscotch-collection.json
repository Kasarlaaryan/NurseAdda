{
  "info": {
    "name": "NurseAdda API",
    "description": "Complete API collection for NurseAdda — Healthcare Staffing Platform",
    "schema": "https://schema.hoppscotch.io/collection.json"
  },
  "auth": {
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "staffToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "clientToken",
      "value": "",
      "type": "string"
    }
  ],
  "folders": [
    {
      "name": "1. Auth — Public (No Token)",
      "requests": [
        {
          "id": "register-staff",
          "name": "Register Staff",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/register-staff",
          "headers": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john.staff@example.com\",\n  \"phone\": \"+919876543210\",\n  \"staffCategory\": \"Nurse\",\n  \"password\": \"staff123\"\n}"
          },
          "test": {
            "tests": [
              "pw.test('Status is 200', () => { pw.response.to.have.status(200) })",
              "pw.test('Returns OTP sent message', () => { pw.expect(pw.response.text()).to.include('OTP sent') })"
            ]
          }
        },
        {
          "id": "register-client",
          "name": "Register Client",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/register-client",
          "headers": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Smith\",\n  \"email\": \"jane.client@example.com\",\n  \"mobileNumber\": \"+919876543211\",\n  \"password\": \"client123\",\n  \"confirmPassword\": \"client123\"\n}"
          },
          "test": {
            "tests": [
              "pw.test('Status is 200', () => { pw.response.to.have.status(200) })",
              "pw.test('Returns OTP sent message', () => { pw.expect(pw.response.text()).to.include('OTP sent') })"
            ]
          }
        },
        {
          "id": "register-admin",
          "name": "Register Admin",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/register-admin",
          "headers": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"firstName\": \"Admin\",\n  \"lastName\": \"User\",\n  \"email\": \"admin@example.com\",\n  \"phone\": \"+919876543212\",\n  \"password\": \"admin123\",\n  \"confirmPassword\": \"admin123\",\n  \"adminType\": \"ADMIN\"\n}"
          },
          "test": {
            "tests": [
              "pw.test('Status is 200', () => { pw.response.to.have.status(200) })",
              "pw.test('Returns success', () => { pw.expect(pw.response.text()).to.include('successfully') })"
            ]
          }
        },
        {
          "id": "send-otp",
          "name": "Send OTP",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/send-otp",
          "headers": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"email\": \"john.staff@example.com\"\n}"
          },
          "test": {
            "tests": [
              "pw.test('Status is 200', () => { pw.response.to.have.status(200) })"
            ]
          }
        },
        {
          "id": "resend-otp",
          "name": "Resend OTP",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/resend-otp",
          "headers": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"email\": \"john.staff@example.com\"\n}"
          },
          "test": {
            "tests": [
              "pw.test('Status is 200', () => { pw.response.to.have.status(200) })"
            ]
          }
        },
        {
          "id": "verify-otp",
          "name": "Verify OTP (Complete Registration)",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/verify-otp",
          "headers": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"email\": \"john.staff@example.com\",\n  \"otp\": \"123456\"\n}"
          },
          "test": {
            "tests": [
              "pw.test('Status is 200', () => { pw.response.to.have.status(200) })",
              "pw.test('Returns verified message (no tokens)', () => { pw.expect(pw.response.text()).to.include('verified') })"
            ]
          },
          "note": "After this, user must call POST /login to get access token"
        },
        {
          "id": "login",
          "name": "Login",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/login",
          "headers": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"email\": \"john.staff@example.com\",\n  \"password\": \"staff123\"\n}"
          },
          "test": {
            "tests": [
              "pw.test('Status is 200', () => { pw.response.to.have.status(200) })",
              "pw.test('Returns access token', () => { pw.expect(pw.response.json().accessToken).to.not.be.empty })",
              "pw.test('Returns refresh token', () => { pw.expect(pw.response.json().refreshToken).to.not.be.empty })",
              "pw.test('Returns user object', () => { pw.expect(pw.response.json().user).to.not.be.null })",
              "pw.environment.set('accessToken', pw.response.json().accessToken)",
              "pw.environment.set('refreshToken', pw.response.json().refreshToken)"
            ]
          }
        },
        {
          "id": "refresh-token",
          "name": "Refresh Token",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/refresh",
          "headers": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
          },
          "test": {
            "tests": [
              "pw.test('Status is 200', () => { pw.response.to.have.status(200) })",
              "pw.test('Returns new access token', () => { pw.expect(pw.response.json().accessToken).to.not.be.empty })",
              "pw.environment.set('accessToken', pw.response.json().accessToken)",
              "pw.environment.set('refreshToken', pw.response.json().refreshToken)"
            ]
          }
        },
        {
          "id": "forgot-password",
          "name": "Forgot Password",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/forgot-password",
          "headers": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"email\": \"john.staff@example.com\"\n}"
          },
          "test": {
            "tests": [
              "pw.test('Status is 200', () => { pw.response.to.have.status(200) })"
            ]
          }
        },
        {
          "id": "reset-password",
          "name": "Reset Password",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/reset-password",
          "headers": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"email\": \"john.staff@example.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"newstaff123\"\n}"
          },
          "test": {
            "tests": [
              "pw.test('Status is 200', () => { pw.response.to.have.status(200) })"
            ]
          }
        }
      ]
    },
